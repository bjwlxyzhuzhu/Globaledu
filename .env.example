# ====== 寰语星球 环境变量样例（复制为 .env 后填写） ======
# 说明：没有 key 也能跑！LLM 层会用 mock 兜底返回占位双语回复，演示主线照样走通。
#       拿到 DeepSeek key 后填到 DEEPSEEK_API_KEY 即可切换到真实大模型。

# DeepSeek（OpenAI 兼容协议）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 可选：本机若需走代理才能访问大模型（DeepSeek 国内一般可直连，留空即可）
# 例：DEV_PROXY=http://127.0.0.1:7897
DEV_PROXY=

# TTS 提供方（占位，可后续切换为真实国内 TTS）
TTS_PROVIDER=mock

# 后端端口
PORT=8787

# SQLite 数据库路径（M5 起真正写入；用 Node 内置 node:sqlite，无需原生编译）
DB_PATH=./data.sqlite

# MiniMax 真人语音 TTS（可选；platform.minimaxi.com 申请 key + GroupId）
# 留空则自动回退浏览器 Web Speech 语音，不影响演示。
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
MINIMAX_BASE_URL=https://api.minimaxi.com
MINIMAX_TTS_MODEL=speech-02-turbo
