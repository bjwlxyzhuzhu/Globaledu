# ====== 寰语星球 环境变量样例（复制为 .env 后填写） ======
# 说明：没有 key 也能跑！LLM 层会用 mock 兜底返回占位双语回复，演示主线照样走通。
#       拿到 DeepSeek key 后填到 DEEPSEEK_API_KEY 即可切换到真实大模型。

# DeepSeek V4（官方 OpenAI 兼容协议）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-pro

# 可选：本机若需走代理才能访问大模型（DeepSeek 国内一般可直连，留空即可）
# 例：DEV_PROXY=http://127.0.0.1:7897
DEV_PROXY=

# TTS 提供方（占位，可后续切换为真实国内 TTS）
TTS_PROVIDER=mock

# 后端端口
PORT=8787

# SQLite 数据库路径（M5 起真正写入；用 Node 内置 node:sqlite，无需原生编译）
DB_PATH=./data.sqlite

# ====== 管理后台 / 登录（M8）======
# 管理员初始密码：首次启动若库中无管理员，会自动创建 admin / 此密码（默认 admin888）。
# 强烈建议改成自己的强密码后重启。登录账号固定为 admin，角色为 teacher。
ADMIN_PASSWORD=admin888
# 登录令牌签名密钥（HMAC）：换成任意长随机串，泄露会导致令牌可被伪造。
# 注意：NODE_ENV=production 时若此项为空或仍是上面的占位串，服务端会**拒绝启动**。
AUTH_SECRET=please-change-this-to-a-long-random-string

# ====== 访问控制与限流 ======
# 跨源白名单：留空＝不允许任何跨源请求（开发走 vite 代理、生产同端口托管，都是同源，无需配置）。
# 确需跨源时填逗号分隔的来源，例：CORS_ORIGINS=https://lxsznt.ujs.edu.cn
CORS_ORIGINS=

# 付费 AI 接口（/chat /tts /quiz/generate /studio/generate /writing/grade）限流。
# 单个学生每小时上限：
AI_RATE_PER_USER_HOURLY=30
# 全站每日总调用上限（钱包保险丝，触顶后统一返回 429）：
AI_RATE_GLOBAL_DAILY=2000

# MiniMax 真人语音 TTS（可选；platform.minimaxi.com 申请 key + GroupId）
# 留空则自动回退浏览器 Web Speech 语音，不影响演示。
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
MINIMAX_BASE_URL=https://api.minimaxi.com
MINIMAX_TTS_MODEL=speech-02-turbo

# ===== 以下为根目录 双创AI星际 (Next.js) 应用所需，复制为 .env.local 填写 =====
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx   # 浏览器端，受 RLS 约束
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx            # 仅服务端，绕过 RLS，切勿暴露
APIMART_BASE_URL=https://api.apimart.ai/v1
APIMART_API_KEY=sk-xxx                             # 仅服务端
CHAT_MODEL=gpt-4o
IMAGE_MODEL=gpt-image-2
EMBED_MODEL=text-embedding-3-small

# 商业级 PPT 引擎（开源 Presenton，github.com/presenton/presenton；不配则 PPT 页只有轻量导出）
PPTGEN_BASE_URL=http://localhost:5001      # 服务端调用引擎的地址
PPTGEN_PUBLIC_URL=                          # 浏览器访问引擎的地址（默认同上；上生产填反代域名）
PPTGEN_AUTH=                                # 可选 Basic 认证 user:pass

# 首页实时动态墙：平台还没有真实数据时是否显示带「演示数据」标注的示例条目（1=开；正式评审前务必置空）
WALL_DEMO=
